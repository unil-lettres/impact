# The following configuration is used for production in conjunction with the
# main docker-compose.yml. Please follow the instructions in the README.md
# file to deploy the application.

services:
  impact-app:
    image: unillett/impact:app-latest
    build:
      context: ./
      dockerfile: ./docker/app.dockerfile
      target: prod
    env_file:
      - ./site/.env
    volumes:
      - uploads-data:/var/www/impact/storage/app/public/uploads
      - exports-data:/var/www/impact/storage/app/public/exports
    restart: unless-stopped
    deploy:
      mode: global
      resources:
        limits:
          memory: 1000M
  impact-shibboleth:
    image: unillett/apache-shibboleth:latest
    env_file:
      - ./docker/shibboleth.env
    ports:
      - "127.0.0.1:8787:8080"
    volumes:
      - ./docker/config/apache-shibboleth.conf:/etc/apache2/vhost.d/custom.conf:ro
      - shibboleth-certs:/var/lib/shibboleth
    depends_on:
      impact-app:
        condition: service_healthy
    healthcheck:
      test: [ "CMD-SHELL", "curl -f http://localhost:8080 || exit 1" ]
      interval: 10s
      timeout: 2s
      retries: 5
      start_period: 30s
    restart: unless-stopped
    deploy:
      mode: global
      resources:
        limits:
          memory: 100M
    networks:
      - impact-net
    container_name: impact-shibboleth
  impact-worker:
    image: unillett/impact:worker-latest
    build:
      context: ./
      dockerfile: ./docker/worker.dockerfile
      target: prod
    env_file:
      - ./site/.env
    volumes:
      - uploads-data:/var/www/impact/storage/app/public/uploads
      - exports-data:/var/www/impact/storage/app/public/exports
    restart: unless-stopped
    deploy:
      mode: global
      resources:
        limits:
          memory: 1000M
  impact-mysql:
    restart: unless-stopped
    deploy:
      mode: global
      resources:
        limits:
          memory: 500M

volumes:
  uploads-data:
  exports-data:
  shibboleth-certs:
