# --------------------------------------------
# Environment variables for the Shibboleth proxy
#
# Only used in production, by the impact-shibboleth service.
# See https://github.com/unil-lettres/apache-shibboleth for the full reference.
# --------------------------------------------

SHIB_HOSTNAME=myhost.com
SHIB_CONTACT=aai@myhost.com
SHIB_PROTECTED_PATHS=/aai
SHIB_ATTRIBUTES=mail,givenName,surname
SHIB_SESSION_PROPERTIES=Shib-Identity-Provider

# Optional: reuse an already registered Shibboleth service provider
# certificate instead of letting the container generate a new one. Accepts
# plain text or base64. Without these, a certificate is generated on first
# startup, persisted in the shibboleth-certs volume, and must be registered
# on https://rr.aai.switch.ch/
#SHIB_SP_KEY=
#SHIB_SP_CERT=
